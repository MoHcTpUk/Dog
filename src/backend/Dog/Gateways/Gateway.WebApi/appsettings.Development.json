{
  "NatsUrl": "nats://localhost:4222",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=identity;Username=user;Password=password"
  },
  "Minio": {
    "Endpoint": "localhost:9009",
    "AccessKey": "adminadmin",
    "SecretKey": "adminadmin"
  },
  "Identity": {
    "ApiUrl": "http://localhost:5000"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-connect": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/connect/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5000"
          }
        }
      }
    }
  }
}