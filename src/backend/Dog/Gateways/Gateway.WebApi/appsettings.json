{
  "NatsUrl": "nats://nats:4222",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Minio": {
    "Endpoint": "localhost:9009",
    "AccessKey": "adminadmin",
    "SecretKey": "adminadmin"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-connect": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/connect/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-webapi:8080"
          }
        }
      }
    }
  }
}